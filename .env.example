# Copy to .env in the repo root; the backend imports it on startup. .env is git-ignored - never commit it.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=deliverypulse
DB_USERNAME=deliverypulse_app
DB_PASSWORD=replace-with-a-local-password
SERVER_PORT=8080
FRONTEND_ORIGIN=http://localhost:4200
APP_TIME_ZONE=UTC

# First admin, created only when the database has no users. Empty = generated and logged once.
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=
APP_SESSION_HOURS=12
# Break-glass: true sets APP_ADMIN_PASSWORD on the admin at every start. Use once, then set back to false.
APP_ADMIN_RESET=false

# Scheduled jobs (cron: second minute hour day-of-month month day-of-week, in APP_TIME_ZONE)
SCHEDULE_ENABLED=true
SCHEDULE_REFRESH_CRON=0 0 6 * * *
SCHEDULE_WEEKLY_REPORT_CRON=0 0 7 * * MON

# Optional AI insights (off unless all three are set). Never commit a real key.
AI_INSIGHTS_ENABLED=false
AI_PROVIDER=gemini
AI_API_KEY=
AI_EXTERNAL_DATA_SHARING_AUTHORIZED=false
AI_MODEL=gemini-flash-latest
AI_TIMEOUT=15s
# Optional second provider, tried when the first fails (e.g. Gemini quota reached).
AI_FALLBACK_PROVIDER=
AI_FALLBACK_API_KEY=
AI_FALLBACK_MODEL=

# Optional email alerts (off unless MAIL_HOST and ALERT_EMAIL_TO are set). For Gmail use an app password.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=

# Optional read-only Jira Cloud sync (off unless the first four are set). Never commit a real token.
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEYS=PAY,MOB,DATA,CRMX,OPS
JIRA_BLOCKED_LABEL=blocked
